<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd job: print Signal Seeker every morning.
  Copy to ~/Library/LaunchAgents/ and replace YOUR_USER (twice) before loading; see README.md.
  It runs at 6:30 and again at 7:30, which is harmless: the script skips a date it already
  printed and prints nothing if today's edition isn't published yet.
  If the Mac was asleep at 6:30, launchd runs the job when it wakes.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.chrisjamesmedia.signalseeker.print</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/YOUR_USER/signal-seeker/print-signal-seeker.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- Leave PRINTER empty for the default printer, or set it to a queue name from `lpstat -p`. -->
    <key>PRINTER</key>
    <string></string>
    <key>MEDIA</key>
    <string>Letter</string>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>StandardOutPath</key>
  <string>/tmp/signal-seeker-print.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/signal-seeker-print.err</string>
</dict>
</plist>
