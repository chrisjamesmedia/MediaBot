{% extends "_base.html.j2" %}
{% set noindex = not paper.public %}
{% set og_type = "article" %}
{% set og_title = paper.name ~ " · " ~ date_long %}
{% set lead = sections[0]['items'][0] %}
{% set og_image = lead.image.web if lead.image else None %}
{% set body_class = "edition" %}
{% macro sources(list) -%}
<span class="src">{% for s in list %}<a href="{{ s.url }}" target="_blank" rel="noopener">{{ s.name }}</a>{% if not loop.last %}<span class="dot"> · </span>{% endif %}{% endfor %}</span>
{%- endmacro %}
{% macro controls() -%}
<span class="ctl" role="group" aria-label="Reactions">
<button type="button" data-r="knew">Knew this</button><button type="button" data-r="more">More like this</button><button type="button" data-r="skip">Skip</button><button type="button" class="readmark" data-read aria-label="Mark read" title="Mark read"></button>
</span>
{%- endmacro %}
{% macro story(s, cls='') -%}
<article class="story {{ cls }}{% if s.brief %} brief{% endif %}" id="{{ s.id }}" data-id="{{ s.id }}">
{% if s.image %}<figure class="ph"><img src="{{ s.image.web }}" alt="" loading="lazy"><figcaption>{{ s.image.credit }}</figcaption></figure>{% endif %}
<div class="txt">
<h3>{{ s.headline }}</h3>
<p>{{ s.summary }}</p>
<footer>{{ sources(s.sources) }}{{ controls() }}</footer>
</div>
</article>
{%- endmacro %}
{% from "_funnies.html.j2" import funnies %}
{% macro quote(q) -%}
{% set ex = q.text | excerpt %}
<a class="quote" href="{{ q.url }}" target="_blank" rel="noopener"><span class="qwho"><b>{{ q.author }}</b> <span class="mute">@{{ q.handle }}</span></span>{% if ex %}<span class="qtext">{{ ex }}</span>{% endif %}</a>
{%- endmacro %}
{% macro post(p) -%}
<article class="post" id="{{ p.id }}" data-id="{{ p.id }}">
<header><span class="av" aria-hidden="true">{{ p.author | initials }}</span><span class="who"><b>{{ p.author }}</b><span class="mute">@{{ p.handle }}{% if p.date_short %} · <a href="{{ p.url }}" target="_blank" rel="noopener"><time datetime="{{ p.date }}">{{ p.date_short }}</time></a>{% endif %}</span></span></header>
<p class="ptext">{{ p.text }}</p>
{% if p.quoted %}{{ quote(p.quoted) }}{% endif %}
{% if p.image %}<figure class="pimg"><img src="{{ p.image.web }}" alt="" loading="lazy"></figure>{% endif %}
<footer><a class="src open" href="{{ p.url }}" target="_blank" rel="noopener">Open on X</a>{{ controls() }}</footer>
</article>
{%- endmacro %}
{% macro line(l) -%}
<li class="line" data-id="{{ l.id }}"><span class="ltext">{{ l.text | safe }}</span> {{ sources(l.sources) }}</li>
{%- endmacro %}
{% macro items_block(items) -%}
{% set stories = items | selectattr('type', 'equalto', 'story') | list %}
{% set posts = items | selectattr('type', 'equalto', 'post') | list %}
{% set lines = items | selectattr('type', 'equalto', 'line') | list %}
{% if stories %}{% set cols = stories | balance %}
<div class="cols n{{ cols|length }}">{% for col in cols %}<div class="col">{% for s in col %}{{ story(s) }}{% endfor %}</div>{% endfor %}</div>
{% endif %}
{% if lines %}<ul class="lines">{% for l in lines %}{{ line(l) }}{% endfor %}</ul>{% endif %}
{% if posts %}<div class="posts{% if posts|length == 1 %} one{% endif %}">{% for p in posts %}{{ post(p) }}{% endfor %}</div>{% endif %}
{%- endmacro %}
{% macro sub_body(sec) -%}
{% if sec.style == 'box' %}
  <div class="box"><ul>{% for l in sec['items'] %}{{ line(l) }}{% endfor %}</ul></div>
{% elif sec.id == 'funnies' %}
  {{ funnies(sec, 'web') }}
{% elif sec.style == 'links' %}
  <ol class="worthlist">{% for w in sec['items'] %}<li data-id="{{ w.id }}"><a href="{{ w.url }}" target="_blank" rel="noopener">{{ w.title }}</a>{% if w.why %} <span class="mute">{{ w.why }}</span>{% endif %}</li>{% endfor %}</ol>
{% elif sec.groups %}
  {% for g in sec.groups %}
  <div class="group{% if sec.group_by == 'ticker' %} hold{% endif %}">
    {% if g.title %}<h4>{{ g.title }}</h4>{% endif %}
    <div>{{ items_block(g['items']) }}</div>
  </div>
  {% endfor %}
{% else %}
  {{ items_block(sec['items']) }}
{% endif %}
{%- endmacro %}
{% block body %}
{% set parts = sections | by_source %}
{% set front = sections | selectattr('id', 'equalto', 'front') | first %}
{% set show_toc = (parts|length + (1 if front else 0) > 1) or (parts and parts[0].subs|length > 1) %}
<header class="mast wrap">
  <div class="topline">
    <time datetime="{{ date }}">{{ date_long }}</time>
    <span class="getpdf">
      <a class="printbtn" href="{{ pdfs.print }}" target="_blank" rel="noopener" title="Letter, double-sided, black on white"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 9V3.5h10V9M7 17.5H4.5v-7a1.5 1.5 0 0 1 1.5-1.5h12a1.5 1.5 0 0 1 1.5 1.5v7H17M7 14h10v6.5H7z"/></svg>Print</a>
      <a class="digi" href="{{ pdfs.digital }}" target="_blank" rel="noopener">Digital PDF</a>
    </span>
  </div>
  <h1><a href="{{ home or '../' }}" title="{{ paper.name }}: all editions">{{ paper.name }}</a></h1>
  <div class="under">
    {% if weather.ok %}<span class="wx" title="Open-Meteo, {{ weather.asof_full }}">{{ weather.line }}</span>{% endif %}
    {% if note %}<span class="note">{{ note }}</span>{% endif %}
  </div>
  {% if show_toc %}
  <nav class="contents" id="contents" aria-labelledby="contents-h">
    <h2 id="contents-h">In this edition</h2>
    <ol class="toc-parts">
      {% if front %}<li><a class="tp" href="#front">Front Page</a></li>{% endif %}
      {% for p in parts %}
      <li><a class="tp" href="#{{ p.anchor }}">{{ p.title }}</a>
        {% if p.subs|length > 1 %}<ol class="toc-subs">{% for t in p.subs %}<li><a href="#{{ t.anchor }}">{{ t.title }}</a></li>{% endfor %}</ol>{% endif %}
      </li>
      {% endfor %}
    </ol>
  </nav>
  {% endif %}
</header>

<main class="wrap">
{% if front %}
{% set fs = front['items'] | selectattr('type', 'equalto', 'story') | list %}
<section id="front" class="front" aria-label="{{ front.title }}" data-sec="front">
  {% set s = fs[0] %}
  <article class="story lead{% if not s.image %} noimg{% endif %}" id="{{ s.id }}" data-id="{{ s.id }}">
  <h3>{{ s.headline }}</h3>
  {% if s.image %}<figure class="ph"><img src="{{ s.image.web }}" alt=""><figcaption>{{ s.image.credit }}</figcaption></figure>{% endif %}
  <div class="txt"><p>{{ s.summary }}</p><footer>{{ sources(s.sources) }}{{ controls() }}</footer></div>
  </article>
  {% if fs|length > 1 %}<div class="grid2 rest{% if fs|length is odd %} even{% endif %}">{% for s in fs[1:] %}{{ story(s) }}{% endfor %}</div>{% endif %}
</section>
{% endif %}
{% for p in parts %}
<section id="{{ p.anchor }}" class="part part-{{ p.id }}" aria-labelledby="{{ p.anchor }}-h">
  <h2 class="part-h" id="{{ p.anchor }}-h">{{ p.title }}</h2>
  {% for sec in p.subs %}
  <section id="{{ sec.anchor }}" class="sec sec-{{ sec.id }}{{ " funnies" if sec.id == "funnies" }}" data-sec="{{ sec.id }}">
    {% if p.subs|length > 1 %}<h3 class="topic">{{ sec.title }}</h3>{% endif %}
    {{ sub_body(sec) }}
  </section>
  {% endfor %}
  {% if show_toc %}<p class="back"><a href="#contents">↑ Contents</a></p>{% endif %}
</section>
{% endfor %}

<section class="end" aria-label="End of edition">
  <p class="fin">That’s today’s paper.</p>
  <form class="fb" id="feedback">
    <label for="fb-text" class="vh">Feedback on this edition</label>
    <textarea id="fb-text" rows="2" placeholder="Feedback on today’s edition"></textarea>
    <button type="submit">Save</button>
  </form>
  <p class="endlinks"><a href="{{ pdfs.print }}" target="_blank" rel="noopener">Print edition</a><span class="dot"> · </span><a href="{{ pdfs.digital }}" target="_blank" rel="noopener">Digital PDF</a><span class="dot"> · </span><button type="button" id="export">Export feedback</button><span class="saved" aria-live="polite"></span></p>
</section>
</main>
<script>window.SG = {paper: "{{ paper.slug }}", edition: "{{ edition_key or date }}"};</script>
<script src="{{ root }}assets/site.js"></script>
{% endblock %}
