{#- Print (mode=print) and digital (mode=digital) PDF editions. Letter, two compact columns, B&W.
    Print carries no photos; its only image is one masthead QR, and only once the site has a public URL.
    Digital adds the lead photo and keeps every link clickable. -#}
<!doctype html><html lang="en"><head><meta charset="utf-8">
<title>{{ paper.name }} · {{ date_long }}{{ ' (print)' if mode == 'print' else '' }}</title>
<style>
@font-face{font-family:"SG Serif";src:url({{ static }}/fonts/SourceSerifPro-Regular.ttf);font-weight:400}
@font-face{font-family:"SG Serif";src:url({{ static }}/fonts/SourceSerifPro-It.ttf);font-weight:400;font-style:italic}
@font-face{font-family:"SG Serif";src:url({{ static }}/fonts/SourceSerifPro-Semibold.ttf);font-weight:600}
@font-face{font-family:"SG Serif";src:url({{ static }}/fonts/SourceSerifPro-Bold.ttf);font-weight:700}
@font-face{font-family:"SG Sans";src:url({{ static }}/fonts/LibreFranklin.ttf);font-weight:100 900}
{% if mode == 'print' %}
{#- Print: pure white, black ink, no fills. Footer names the duplex sheet and side; build.py pads to an even page count. #}
@page{size:Letter;margin:.5in .5in .55in;background:#fff}
@page :right{counter-increment:sheet;@bottom-center{content:"Sheet " counter(sheet) " of {{ sheets or 1 }} · Front · p. " counter(page);font:400 6.8pt "SG Sans",sans-serif;color:#000}}
@page :left{@bottom-center{content:"Sheet " counter(sheet) " of {{ sheets or 1 }} · Back · p. " counter(page);font:400 6.8pt "SG Sans",sans-serif;color:#000}}
{% else %}
{#- Digital: soft warm paper, near-black warm ink. #}
@page{size:Letter;margin:.5in .5in .55in;background:#f4ecdc;
  @bottom-center{content:counter(page);font:400 7.5pt "SG Sans",sans-serif;color:#1c1914}}
{% endif %}
*{box-sizing:border-box}
html{-webkit-print-color-adjust:exact;print-color-adjust:exact}
body{margin:0;color:{{ '#000' if mode == 'print' else '#1c1914' }};background:{{ '#fff' if mode == 'print' else '#f4ecdc' }};font:400 {{ pt }}pt/1.36 "SG Serif",Georgia,serif;hyphens:auto;orphans:2;widows:2}
a{color:inherit;text-decoration:none}
.sans{font-family:"SG Sans",sans-serif}
/* masthead */
.mast{display:flex;align-items:flex-end;justify-content:space-between;gap:12pt;padding-bottom:4pt;border-bottom:.6pt solid #000}
.name{text-align:left;font:400 19pt/1 "SG Serif",serif;letter-spacing:.01em}
.mast .date{font:500 8pt/1.25 "SG Sans",sans-serif;text-align:right;margin-left:auto}
.qr{width:.5in;height:.5in;display:block}
.strip{display:flex;justify-content:space-between;gap:14pt;padding:3pt 0;border-bottom:1.6pt double #000;
  font:400 7.4pt/1.35 "SG Sans",sans-serif;margin-bottom:9pt}
.strip .nt{text-align:right;max-width:52%}
/* columns */
.cols{column-count:2;column-gap:.24in;column-rule:.4pt solid #999;column-fill:balance}
.lead{column-span:all;padding-bottom:8pt;margin-bottom:9pt;border-bottom:.6pt solid #000}
.lead h3{font:700 {{ pt + 6.5 }}pt/1.12 "SG Serif",serif;margin:0 0 4pt;text-wrap:balance}
.lead .wrapl{display:flex;gap:12pt}
.lead .wrapl p{flex:1;font-size:{{ pt + 0.6 }}pt;column-count:{{ 1 if mode == 'digital' else 2 }};column-gap:.24in}
.lead figure{flex:0 0 3.3in;margin:0}
.lead img{width:100%;height:1.9in;object-fit:cover;display:block}
.lead figcaption{font:400 6pt "SG Sans",sans-serif;color:#444;text-align:right;margin-top:1pt}
h2{font:700 7.6pt/1 "SG Sans",sans-serif;letter-spacing:.14em;text-transform:uppercase;margin:12pt 0 5pt;padding-top:3.5pt;
  border-top:1.4pt solid #000;break-after:avoid}
.cols > section:first-child h2,.lead + section h2{margin-top:0}
.fronth{column-span:all}
/* source parts (X, News, …) hold topic sections */
.part{margin-top:10pt}
.parth{font:400 13pt/1.1 "SG Serif",serif;margin:0 0 6pt;padding-top:4pt;border-top:1.6pt double #000;break-after:avoid}
.tp{font:700 7.6pt/1 "SG Sans",sans-serif;letter-spacing:.14em;text-transform:uppercase;margin:12pt 0 5pt;padding-top:3.5pt;
  border-top:1.4pt solid #000;break-after:avoid}
.cols > section:first-child .tp{margin-top:0}
/* contents */
.toc{margin:0 0 9pt;padding:0 0 6pt;border-bottom:.6pt solid #000;font:400 7.2pt/1.45 "SG Sans",sans-serif;column-count:{{ 3 if mode == 'print' else 2 }};column-gap:.24in}
.toc .th{column-span:all;font:700 6.8pt/1 "SG Sans",sans-serif;letter-spacing:.14em;text-transform:uppercase;margin:0 0 4pt}
.toc p{margin:0 0 2.5pt;break-inside:avoid}
.toc .tpa{display:flex;font-weight:600}
.toc .ts{display:flex;padding-left:8pt;color:{{ '#000' if mode == 'print' else '#3a352d' }}}
.toc a{flex:0 1 auto}
.toc .lead-dots{flex:1;border-bottom:.4pt dotted {{ '#000' if mode == 'print' else '#8a8170' }};margin:0 3pt 2.2pt;min-width:6pt}
.toc .pg{flex:0 0 auto;min-width:9pt;text-align:right;font-variant-numeric:tabular-nums}
h4{font:600 6.8pt/1.2 "SG Sans",sans-serif;letter-spacing:.09em;text-transform:uppercase;margin:7pt 0 3pt;color:#222;break-after:avoid}
h2 + h4{margin-top:2pt}
.it{break-inside:avoid;margin:0 0 6.5pt}
.it h3{font:700 {{ pt + 1.2 }}pt/1.18 "SG Serif",serif;margin:0 0 1.5pt}
.it p{margin:0}
.it.brief h3{font:600 6.8pt/1.2 "SG Sans",sans-serif;letter-spacing:.09em;text-transform:uppercase}
.src{font:400 6.4pt/1.3 "SG Sans",sans-serif;color:#333;white-space:normal}
p .src{margin-left:3pt}
{% if mode == 'digital' %}.src a,.wl a{text-decoration:underline;text-decoration-color:#aaa}{% endif %}
/* X post cards */
.post{break-inside:avoid;border:.6pt solid #000;border-radius:4pt;padding:4.5pt 6pt 4pt;margin:0 0 6pt}
.post.long{break-inside:auto;box-decoration-break:slice}
.post .hd{break-after:avoid;display:flex;align-items:center;gap:5pt;margin-bottom:2.5pt;font:400 7pt/1.2 "SG Sans",sans-serif}
.post .av{width:15pt;height:15pt;border-radius:50%;border:.6pt solid #000;display:flex;align-items:center;justify-content:center;
  font:600 5.6pt/1 "SG Sans",sans-serif;flex:0 0 15pt}
.post .hd b{font-weight:700;font-size:7.6pt}
.post .hd span{color:#333}
.post .tx{font:400 {{ pt - 0.3 }}pt/1.36 "SG Sans",sans-serif;white-space:pre-line}
.post .u{font:400 5.8pt/1.2 "SG Sans",sans-serif;color:#444;margin-top:2pt}
/* evergreen: long reads */
.ev{break-inside:avoid;margin:0 0 7pt;padding-bottom:5pt;border-bottom:.4pt solid #999}
.ev .k{font:600 6.2pt/1.2 "SG Sans",sans-serif;letter-spacing:.1em;text-transform:uppercase;color:#333}
.ev h3{font:700 {{ pt + 1.6 }}pt/1.16 "SG Serif",serif;margin:1.5pt 0 1pt}
.ev .by{font:500 7pt/1.25 "SG Sans",sans-serif;margin-bottom:2pt}
.ev p{margin:0}
.ev .u{font:400 5.8pt/1.2 "SG Sans",sans-serif;color:#444;margin-top:2pt}
/* News: briefs */
.nb{break-inside:avoid;margin:0 0 4pt}
.nb b{font-weight:700}
/* lines, box, links */
.ln{break-inside:avoid;margin:0 0 3.5pt}
.box{border:.8pt solid #000;padding:5pt 7pt 3pt;margin:12pt 0 6pt;break-inside:avoid}
.box h2,.box .tp{border-top:0;padding-top:0;margin-top:0}
.wl{margin:0 0 4pt;break-inside:avoid}
.wl b{font-weight:600}
.end{text-align:center;margin-top:8pt;padding-top:5pt;border-top:1.6pt double #000;
  font:italic 400 {{ pt }}pt "SG Serif",serif;break-inside:avoid;break-before:avoid}
/* quoted post inset */
.qt{border:.5pt solid #000;border-radius:3pt;padding:2.5pt 4.5pt;margin:3pt 0 1pt;font:400 {{ pt - 1.4 }}pt/1.32 "SG Sans",sans-serif}
.qt b{font-weight:700}
.qt .h{color:#333}
/* funnies: lead comic full width, the others two-up; one-liners and feed posts side by side; puzzles in black line only */
.funnies .parth{margin-bottom:8pt}
.comics{display:grid;grid-template-columns:1fr 1fr;gap:8pt 14pt;align-items:end;margin:0 0 8pt}
.comic{margin:0;break-inside:avoid;text-align:center}
.comic.c1{grid-column:1/-1}
.comic img{max-width:100%;max-height:2.9in;filter:grayscale(1)}
.comic.c1 img{max-height:2.5in}
.comic figcaption{font:400 6.4pt/1.3 "SG Sans",sans-serif;color:#333;margin-top:2pt;word-break:break-word}
.funrow{display:grid;grid-template-columns:1fr 1fr;gap:14pt;margin:0 0 9pt;padding-top:5pt;border-top:.5pt solid #000;break-inside:avoid}
.funrow>div:only-child{grid-column:1/-1}
.funrow h4{margin:0 0 3pt}
.joke,.fpost{margin:0 0 6pt;break-inside:avoid}
.joke blockquote,.fpost blockquote{margin:0;font:italic 400 {{ pt + 0.4 }}pt/1.4 "SG Serif",serif;white-space:pre-line}
.joke figcaption,.fpost figcaption{font:400 6.6pt/1.35 "SG Sans",sans-serif;margin-top:1.5pt}
.joke .src,.fpost .src{display:block;font-size:6pt;color:#333;word-break:break-all}
.fpost img{display:block;max-width:100%;max-height:1.7in;margin:0 0 3pt;filter:grayscale(1)}
.fpost .h{color:#333}
{% if mode == 'print' %}.fpost blockquote{font-variant-emoji:text;filter:grayscale(1)}{% endif %}
.puzzles{display:flex;gap:.35in;justify-content:center;align-items:flex-start;break-inside:avoid}
.pz h4{margin-top:0}
.sudoku,.ws{display:grid;grid-template-columns:repeat(var(--n),var(--c));border:1.6pt solid #000;width:max-content}
.sudoku{--c:17pt}.ws{--c:12.5pt}
.sudoku span,.ws span{width:var(--c);height:var(--c);display:flex;align-items:center;justify-content:center;font:500 9pt/1 "SG Sans",sans-serif}
.sudoku span{border-top:.4pt solid #000;border-left:.4pt solid #000}
.sudoku span:nth-child(-n+9){border-top:0}.sudoku span:nth-child(9n+1){border-left:0}
.sudoku span.bt{border-top-width:1.6pt}.sudoku span.bl{border-left-width:1.6pt}
.ws{border-width:.6pt}.ws span{font-size:7.6pt;letter-spacing:0}
.pzn{font:400 6.8pt/1.4 "SG Sans",sans-serif;max-width:150pt;margin:4pt 0 0}
.sols{display:flex;gap:16pt;justify-content:center;margin-top:10pt;transform:rotate(180deg);break-inside:avoid}
.sol span:first-child{display:block;font:400 5.5pt "SG Sans",sans-serif;margin-bottom:1pt}
.sol .sudoku{--c:8pt}.sol .ws{--c:5.6pt}
.sol .sudoku span{font-size:5.4pt}.sol .ws span{font-size:4.4pt}
.sol .sudoku span{border-top-width:.25pt;border-left-width:.25pt}
.sol .sudoku span.bt{border-top-width:.8pt}.sol .sudoku span.bl{border-left-width:.8pt}
.sol .sudoku{border-width:.8pt}
.padpage{break-before:page;height:1px}
/* The Passage */
.passage{margin:0 auto 4pt;max-width:5.4in;break-inside:avoid;text-align:left}
.passage .pk{font:600 6.6pt "SG Sans",sans-serif;letter-spacing:.08em;text-transform:uppercase;margin:0 0 3pt}
.passage .pt{margin:0;font:italic 400 {{ pt + 1.6 }}pt/1.45 "SG Serif",serif}
.passage .pt.verse{white-space:pre-line}
.passage figcaption{font:400 {{ pt - 1 }}pt/1.4 "SG Sans",sans-serif;margin-top:4pt}
.passage .purl{display:block;font-size:6.4pt;color:#333;margin-top:1pt;word-break:break-all}
/* Games: answers live on the last page */
.games{display:grid;grid-template-columns:1fr 1fr;gap:10pt 18pt;font:400 {{ pt - 0.6 }}pt/1.4 "SG Sans",sans-serif}
.game{break-inside:avoid}.game h4{margin:0 0 3pt}
.cwwrap{flex-direction:column;gap:6pt!important}
.mq{margin:0;padding-left:14pt}.mq li{margin:0 0 3pt}
.wr{font-weight:600;margin:0 0 4pt}.gq{margin:4pt 0 0}
.cards{display:flex;gap:6pt}.card{border:.8pt solid #000;border-radius:3pt;padding:9pt 4pt;min-width:44pt;text-align:center;font-weight:600}
.rq{margin:0;font-style:italic}
.cwwrap{display:flex;gap:16pt;align-items:flex-start}
.cw{display:grid;grid-template-columns:repeat(var(--n),21pt);border:1.4pt solid #000;width:max-content}
.cw span{width:21pt;height:21pt;border:.4pt solid #000;position:relative;display:flex;align-items:center;justify-content:center;font:600 12pt "SG Sans",sans-serif}
.cw span i{position:absolute;top:1pt;left:1.5pt;font:400 6pt "SG Sans",sans-serif;font-style:normal}
.cw .blk{background:#000}
.clues{display:flex;gap:10pt}.clues>div{flex:1}.clues p{margin:1pt 0}.clues i{font-style:normal;font-weight:600}
.answers{break-before:page}
.gamesh{break-before:page}
.ans{display:grid;grid-template-columns:1fr 1fr;gap:10pt 18pt;font:400 {{ pt - 1 }}pt/1.4 "SG Sans",sans-serif}
.an{break-inside:avoid}.an h4{margin:0 0 2pt}
.ga{margin:0;padding-left:14pt}.ga .how{color:#333}p.ga{padding-left:0}
.ga.cwa{padding-left:0}.cwa .cw{grid-template-columns:repeat(var(--n),16pt)}.cwa .cw span{width:16pt;height:16pt;font-size:8.5pt}
.pzs .sudoku{--c:13pt}.pzs .ws{--c:10pt}.pzs .sudoku span{font-size:8pt}.pzs .ws span{font-size:7pt}
.dek{font:italic 400 7.4pt/1.35 "SG Serif",serif;color:#333;margin:0 0 4pt}
.answered{font:400 7pt/1.4 "SG Sans",sans-serif;margin-top:8pt}
.end .cov{display:block;font:400 6.4pt/1.4 "SG Sans",sans-serif;font-style:normal;color:#333;margin-top:3pt}
</style></head><body>
{%- from "_funnies.html.j2" import funnies, games, answers, passage -%}
{%- macro srcs(list) -%}
<span class="src">{% for s in list %}{% if mode == 'digital' %}<a href="{{ s.url }}">{{ s.name }}</a>{% else %}{{ s.name }}{% endif %}{% if not loop.last %} · {% endif %}{% endfor %}</span>
{%- endmacro -%}
{%- macro item(it) -%}
{% if it.type == 'post' %}
<div class="post{% if (it.text or "")|length > 520 %} long{% endif %}"><div class="hd"><span class="av">{{ it.author | initials }}</span><b>{{ it.author }}</b><span>@{{ it.handle }}{% if it.date_short %} · {{ it.date_short }}{% endif %}</span></div>
<div class="tx">{{ it.text }}</div>
{% if it.quoted %}{% set ex = it.quoted.text | excerpt %}<div class="qt"><b>{{ it.quoted.author }}</b> <span class="h">@{{ it.quoted.handle }}</span>{% if ex %}<br>{{ ex }}{% endif %}</div>{% endif %}
<div class="u">{% if mode == 'digital' %}<a href="{{ it.url }}">{{ it.url | replace('https://', '') }}</a>{% else %}{{ it.url | replace('https://', '') }}{% endif %}</div></div>
{% elif it.type == 'line' %}
<p class="ln">{{ it.text | safe }} {{ srcs(it.sources) }}</p>
{% elif it.type == 'evergreen' %}
<div class="ev"><div class="k">{{ it.kind or 'Long read' }}{% if it.date_short %} · {{ it.date_short }}{% endif %}</div><h3>{% if mode == 'digital' %}<a href="{{ it.url }}">{{ it.title }}</a>{% else %}{{ it.title }}{% endif %}</h3>
<div class="by">{{ it.author }}{% if it.handle %} @{{ it.handle }}{% endif %}</div><p>{{ it.print_text }}</p>
<div class="u">{% if mode == 'digital' %}<a href="{{ it.url }}">{{ it.url | replace('https://', '') }}</a>{% else %}{{ it.url | replace('https://', '') }}{% endif %}</div></div>
{% elif it.type == 'link' %}
<p class="wl"><b>{% if mode == 'digital' %}<a href="{{ it.url }}">{{ it.title }}</a>{% else %}{{ it.title }}{% endif %}</b>{% if it.why %} {{ it.why }}{% endif %} <span class="src">{{ it.url | host }}</span></p>
{% else %}
<div class="it{% if it.brief %} brief{% endif %}"><h3>{{ it.headline }}</h3><p>{{ it.print_text }} {{ srcs(it.sources) }}</p></div>
{% endif %}
{%- endmacro -%}
{% set parts = sections | by_source %}
{% set front = sections | selectattr('id', 'equalto', 'front') | first %}
{% set show_toc = (parts|length + (1 if front else 0) > 1) or (parts and parts[0].subs|length > 1) %}
{%- macro tocline(cls, anchor, title) -%}
<span class="{{ cls }}"><a href="#{{ anchor }}">{{ title }}</a>{% if toc_pages[anchor] %}<span class="lead-dots"></span><span class="pg">{{ toc_pages[anchor] }}</span>{% endif %}</span>
{%- endmacro -%}
<div class="mast">
  <div class="name">{{ paper.name }}</div>
  <div class="date">{{ date_long }}</div>
  {% if qr and mode == 'print' %}<img class="qr" src="{{ qr }}" alt="">{% endif %}
</div>
<div class="strip">
  <span>{% if weather.ok %}{{ weather.line }}{% endif %}</span>
  {% if note %}<span class="nt">{{ note }}</span>{% endif %}
</div>
{% if show_toc %}
<nav class="toc"><div class="th">In this edition</div>
  {% if front %}<p>{{ tocline('tpa', 'front', front.title) }}</p>{% endif %}
  {% for p in parts %}<p>{{ tocline('tpa', p.anchor, p.title) }}{% if p.subs|length > 1 %}{% for t in p.subs %}{{ tocline('ts', t.anchor, t.title) }}{% endfor %}{% endif %}</p>{% endfor %}
</nav>
{% endif %}
{% if front %}
<div class="cols" id="front">
  {% set l = front['items'][0] %}
  <h2 class="parth fronth">{{ front.title }}</h2>
  {% if l.type == 'post' %}<div class="lead">{{ item(l) }}</div>{% else %}
  <div class="lead"><h3>{{ l.headline }}</h3>
    <div class="wrapl">{% if mode == 'digital' and l.image %}<figure><img src="{{ l.image.abs }}" alt=""><figcaption>{{ l.image.credit }}</figcaption></figure>{% endif %}
    <p>{{ l.print_text }} {{ srcs(l.sources) }}</p></div></div>{% endif %}
  <section>{% for it in front['items'][1:] %}{{ item(it) }}{% endfor %}</section>
</div>
{% endif %}
{% for p in parts %}
<section class="part{% if p.id in ('funnies', 'passage') %} {{ p.id }}{% endif %}" id="{{ p.anchor }}">
  <h2 class="parth">{{ p.title }}</h2>
  {% if p.id == 'funnies' %}
  {% for sec in p.subs %}<div id="{{ sec.anchor }}">{% if sec.id == 'games' %}{% if not loop.first %}<h2 class="parth gamesh">Games</h2>{% endif %}{{ games(sec, mode) }}{% else %}{{ funnies(sec, mode) }}{% endif %}</div>{% endfor %}
  {% elif p.id == 'passage' %}
  {% for sec in p.subs %}<div id="{{ sec.anchor }}">{% for it in sec['items'] %}{{ passage(it, mode) }}{% endfor %}</div>{% endfor %}
  {% else %}
  <div class="cols">
  {% for sec in p.subs %}
    {% set th = p.subs|length > 1 %}
    {% if sec.style == 'brief' %}
    <section id="{{ sec.anchor }}">{% if th %}<h3 class="tp">{{ sec.title }}</h3>{% endif %}{% for it in sec['items'] %}<p class="nb"><b>{{ it.headline or (it.text | striptags) }}.</b>{% if it.headline %} {{ it.brief_text }}{% endif %} {{ srcs(it.sources or []) }}</p>{% endfor %}</section>
    {% elif sec.style == 'box' %}
    <section class="box" id="{{ sec.anchor }}">{% if th %}<h3 class="tp">{{ sec.title }}</h3>{% endif %}{% for it in sec['items'] %}{{ item(it) }}{% endfor %}</section>
    {% else %}
    <section id="{{ sec.anchor }}">{% if th %}<h3 class="tp">{{ sec.title }}</h3>{% endif %}{% if sec.dek %}<p class="dek">{{ sec.dek }}</p>{% endif %}
    {% if sec.groups %}{% for g in sec.groups %}{% if g.title %}<h4>{{ g.title }}</h4>{% endif %}{% for it in g['items'] %}{{ item(it) }}{% endfor %}{% endfor %}
    {% else %}{% for it in sec['items'] %}{{ item(it) }}{% endfor %}{% endif %}
    </section>
    {% endif %}
  {% endfor %}
  </div>
  {% endif %}
</section>
{% endfor %}
{% if answered %}<div class="answered"><b>Tuned from your notes:</b> {% for r in answered %}#{{ r.issue }} {{ r.title }}{% if r.answer %} → {{ r.answer }}{% endif %}{% if not loop.last %}; {% endif %}{% endfor %}.</div>{% endif %}
<div class="end">End of today’s paper.{% if coverage %}<span class="cov">{{ coverage }}{% if mode == 'print' %} Links are in the web edition.{% endif %}</span>{% endif %}{% if mode == 'digital' and request_box %}<span class="cov">Want more or less of something tomorrow? Tell us in “Tune tomorrow’s paper” at the end of the {% if base %}<a href="{{ base ~ url_path }}#tune">web edition</a>{% else %}web edition{% endif %}.</span>{% endif %}</div>
{% if pad %}<div class="padpage"></div>{% endif %}
{{ answers(sections) }}
</body></html>
