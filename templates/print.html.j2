{#- Print (mode=print) and digital (mode=digital) PDF editions. Letter, two compact columns, B&W.
    Print carries no photos; its only image is one masthead QR, and only once the site has a public URL.
    Digital adds the lead photo and keeps every link clickable. -#}
<!doctype html><html lang="en"><head><meta charset="utf-8">
<title>{{ paper.name }} {{ paper.version }} · {{ date_long }}{{ ' (print)' if mode == 'print' else '' }}</title>
<style>
@font-face{font-family:"SG Serif";src:url({{ static }}/fonts/SourceSerifPro-Regular.ttf);font-weight:400}
@font-face{font-family:"SG Serif";src:url({{ static }}/fonts/SourceSerifPro-It.ttf);font-weight:400;font-style:italic}
@font-face{font-family:"SG Serif";src:url({{ static }}/fonts/SourceSerifPro-Semibold.ttf);font-weight:600}
@font-face{font-family:"SG Serif";src:url({{ static }}/fonts/SourceSerifPro-Bold.ttf);font-weight:700}
@font-face{font-family:"SG Sans";src:url({{ static }}/fonts/LibreFranklin.ttf);font-weight:100 900}
@page{size:Letter;margin:.5in .5in .55in;
  @bottom-center{content:counter(page);font:400 7.5pt "SG Sans",sans-serif;color:#000}}
@page:first{@bottom-center{content:counter(page)}}
*{box-sizing:border-box}
html{-webkit-print-color-adjust:exact;print-color-adjust:exact}
body{margin:0;color:#000;font:400 {{ pt }}pt/1.36 "SG Serif",Georgia,serif;hyphens:auto;orphans:2;widows:2}
a{color:#000;text-decoration:none}
.sans{font-family:"SG Sans",sans-serif}
/* masthead */
.mast{display:flex;align-items:flex-end;justify-content:space-between;gap:12pt;padding-bottom:4pt;border-bottom:.6pt solid #000}
.name{font:400 19pt/1 "SG Serif",serif;letter-spacing:.01em}
.name .ver{font:400 6.5pt "SG Sans",sans-serif;color:#555;margin-left:4pt;vertical-align:.95em;letter-spacing:.04em}
.mast .date{font:500 8pt/1.25 "SG Sans",sans-serif;text-align:right;margin-left:auto}
.qr{width:.5in;height:.5in;display:block}
.strip{display:flex;justify-content:space-between;gap:14pt;padding:3pt 0;border-bottom:1.6pt double #000;
  font:400 7.4pt/1.35 "SG Sans",sans-serif;margin-bottom:9pt}
.strip .nt{text-align:right;max-width:52%}
/* columns */
.cols{column-count:2;column-gap:.24in;column-rule:.4pt solid #999;column-fill:balance}
.lead{column-span:all;padding-bottom:8pt;margin-bottom:9pt;border-bottom:.6pt solid #000}
.lead h3{font:700 {{ pt + 6.5 }}pt/1.12 "SG Serif",serif;margin:0 0 4pt;text-wrap:balance}
.lead .wrapl{display:flex;gap:12pt}
.lead .wrapl p{flex:1;font-size:{{ pt + 0.6 }}pt;column-count:{{ 1 if mode == 'digital' else 2 }};column-gap:.24in}
.lead figure{flex:0 0 3.3in;margin:0}
.lead img{width:100%;height:1.9in;object-fit:cover;display:block}
.lead figcaption{font:400 6pt "SG Sans",sans-serif;color:#444;text-align:right;margin-top:1pt}
h2{font:700 7.6pt/1 "SG Sans",sans-serif;letter-spacing:.14em;text-transform:uppercase;margin:12pt 0 5pt;padding-top:3.5pt;
  border-top:1.4pt solid #000;break-after:avoid}
.cols > section:first-child h2,.lead + section h2{margin-top:0}
h4{font:600 6.8pt/1.2 "SG Sans",sans-serif;letter-spacing:.09em;text-transform:uppercase;margin:7pt 0 3pt;color:#222;break-after:avoid}
h2 + h4{margin-top:2pt}
.it{break-inside:avoid;margin:0 0 6.5pt}
.it h3{font:700 {{ pt + 1.2 }}pt/1.18 "SG Serif",serif;margin:0 0 1.5pt}
.it p{margin:0}
.it.brief h3{font:600 6.8pt/1.2 "SG Sans",sans-serif;letter-spacing:.09em;text-transform:uppercase}
.src{font:400 6.4pt/1.3 "SG Sans",sans-serif;color:#333;white-space:normal}
p .src{margin-left:3pt}
{% if mode == 'digital' %}.src a,.wl a{text-decoration:underline;text-decoration-color:#aaa}{% endif %}
/* X post cards */
.post{break-inside:avoid;border:.6pt solid #000;border-radius:4pt;padding:4.5pt 6pt 4pt;margin:0 0 6pt}
.post .hd{display:flex;align-items:center;gap:5pt;margin-bottom:2.5pt;font:400 7pt/1.2 "SG Sans",sans-serif}
.post .av{width:15pt;height:15pt;border-radius:50%;border:.6pt solid #000;display:flex;align-items:center;justify-content:center;
  font:600 5.6pt/1 "SG Sans",sans-serif;flex:0 0 15pt}
.post .hd b{font-weight:700;font-size:7.6pt}
.post .hd span{color:#333}
.post .tx{font:400 {{ pt - 0.3 }}pt/1.36 "SG Sans",sans-serif;white-space:pre-line}
.post .u{font:400 5.8pt/1.2 "SG Sans",sans-serif;color:#444;margin-top:2pt}
/* lines, box, links */
.ln{break-inside:avoid;margin:0 0 3.5pt}
.box{border:.8pt solid #000;padding:5pt 7pt 3pt;margin:12pt 0 6pt;break-inside:avoid}
.box h2{border-top:0;padding-top:0;margin-top:0}
.wl{margin:0 0 4pt;break-inside:avoid}
.wl b{font-weight:600}
.end{text-align:center;margin-top:8pt;padding-top:5pt;border-top:1.6pt double #000;
  font:italic 400 {{ pt }}pt "SG Serif",serif;break-inside:avoid;break-before:avoid}
.end .cov{display:block;font:400 6.4pt/1.4 "SG Sans",sans-serif;font-style:normal;color:#333;margin-top:3pt}
</style></head><body>
{%- macro srcs(list) -%}
<span class="src">{% for s in list %}{% if mode == 'digital' %}<a href="{{ s.url }}">{{ s.name }}</a>{% else %}{{ s.name }}{% endif %}{% if not loop.last %} · {% endif %}{% endfor %}</span>
{%- endmacro -%}
{%- macro item(it) -%}
{% if it.type == 'post' %}
<div class="post"><div class="hd"><span class="av">{{ it.author | initials }}</span><b>{{ it.author }}</b><span>@{{ it.handle }}{% if it.date_short %} · {{ it.date_short }}{% endif %}</span></div>
<div class="tx">{{ it.text }}</div>
<div class="u">{% if mode == 'digital' %}<a href="{{ it.url }}">{{ it.url | replace('https://', '') }}</a>{% else %}{{ it.url | replace('https://', '') }}{% endif %}</div></div>
{% elif it.type == 'line' %}
<p class="ln">{{ it.text | safe }} {{ srcs(it.sources) }}</p>
{% elif it.type == 'link' %}
<p class="wl"><b>{% if mode == 'digital' %}<a href="{{ it.url }}">{{ it.title }}</a>{% else %}{{ it.title }}{% endif %}</b>{% if it.why %} {{ it.why }}{% endif %} <span class="src">{{ it.url | host }}</span></p>
{% else %}
<div class="it{% if it.brief %} brief{% endif %}"><h3>{{ it.headline }}</h3><p>{{ it.print_text }} {{ srcs(it.sources) }}</p></div>
{% endif %}
{%- endmacro -%}
<div class="mast">
  <div class="name">{{ paper.name }}{% if paper.version %}<span class="ver">{{ paper.version }}</span>{% endif %}</div>
  <div class="date">{{ date_long }}</div>
  {% if qr and mode == 'print' %}<img class="qr" src="{{ qr }}" alt="">{% endif %}
</div>
<div class="strip">
  <span>{% if weather.ok %}<b>{{ weather.label }}</b> {{ weather.now }}° {{ weather.cond }} · H {{ weather.hi }}° L {{ weather.lo }}°{% for d in weather.days %} · {{ d.name }} {{ d.hi }}°/{{ d.lo }}°{% endfor %}{% endif %}</span>
  {% if note %}<span class="nt">{{ note }}</span>{% endif %}
</div>
<div class="cols">
{% for sec in sections %}
{% if sec.id == 'front' %}
  {% set l = sec['items'][0] %}
  <div class="lead"><h3>{{ l.headline }}</h3>
    <div class="wrapl">{% if mode == 'digital' and l.image %}<figure><img src="{{ l.image.abs }}" alt=""><figcaption>{{ l.image.credit }}</figcaption></figure>{% endif %}
    <p>{{ l.print_text }} {{ srcs(l.sources) }}</p></div></div>
  <section>{% for it in sec['items'][1:] %}{{ item(it) }}{% endfor %}</section>
{% elif sec.style == 'box' %}
  <section class="box"><h2>{{ sec.title }}</h2>{% for it in sec['items'] %}{{ item(it) }}{% endfor %}</section>
{% else %}
  <section><h2>{{ sec.title }}</h2>
  {% if sec.groups %}{% for g in sec.groups %}{% if g.title %}<h4>{{ g.title }}</h4>{% endif %}{% for it in g['items'] %}{{ item(it) }}{% endfor %}{% endfor %}
  {% else %}{% for it in sec['items'] %}{{ item(it) }}{% endfor %}{% endif %}
  </section>
{% endif %}
{% endfor %}
  <div class="end">End of today’s paper.{% if coverage %}<span class="cov">{{ coverage }}{% if mode == 'print' %} Links are in the web edition.{% endif %}</span>{% endif %}</div>
</div>
</body></html>
