{#- Field Notes PDFs. mode=print: letter, two flowing columns, no boxed cards, white/black ink.
    mode=digital: same pages on warm paper. Thin rules + typography instead of frames. Name from paper.name. -#}
<!doctype html><html lang="en"><head><meta charset="utf-8">
<title>{{ paper.name }} · {{ date_long }}{{ ' (print)' if mode == 'print' else '' }}</title>
<style>
@font-face{font-family:"SG Serif";src:url({{ static }}/fonts/SourceSerifPro-Regular.ttf);font-weight:400}
@font-face{font-family:"SG Serif";src:url({{ static }}/fonts/SourceSerifPro-It.ttf);font-weight:400;font-style:italic}
@font-face{font-family:"SG Serif";src:url({{ static }}/fonts/SourceSerifPro-Semibold.ttf);font-weight:600}
@font-face{font-family:"SG Sans";src:url({{ static }}/fonts/LibreFranklin.ttf);font-weight:100 900}
{% set ink = '#000' if mode == 'print' else '#1c1914' %}
{% set bg = '#fff' if mode == 'print' else '#f4ecdc' %}
{% set rule = 'rgba(0,0,0,.2)' if mode == 'print' else 'rgba(28,25,20,.2)' %}
@page{size:Letter;margin:.48in .52in .52in;background:{{ bg }};
  @bottom-center{content:"{{ paper.name }} · " counter(page);font:400 7.5pt "SG Sans",sans-serif;color:{{ ink }}}}
*{box-sizing:border-box}
html{-webkit-print-color-adjust:exact;print-color-adjust:exact}
body{margin:0;color:{{ ink }};background:{{ bg }};font:400 {{ pt }}pt/1.36 "SG Serif",Georgia,serif;orphans:2;widows:2}
.mast{display:flex;justify-content:space-between;align-items:baseline;gap:12pt;margin:0 0 10pt;padding-bottom:5pt;
  border-bottom:.65pt solid {{ ink }}}
.mast .t{font:600 13.5pt/1 "SG Serif",serif;letter-spacing:-.01em}
.mast .meta{font:400 7.4pt/1.25 "SG Sans",sans-serif;text-align:right}
.stream{column-count:2;column-gap:18pt;column-fill:auto;column-rule:.35pt solid {{ rule }}}
.sec-head{font:600 6.6pt/1.2 "SG Sans",sans-serif;letter-spacing:.11em;text-transform:uppercase;
  margin:8pt 0 4pt;break-after:avoid-column}
.sec-head:first-child{margin-top:0}
.post{padding:0 0 6.5pt;margin:0 0 6.5pt;border-bottom:.3pt solid {{ rule }}}
.who{font:400 6.6pt/1.2 "SG Sans",sans-serif;margin:0 0 3pt;letter-spacing:.01em;break-after:avoid}
.who b{font-weight:600}
.who .tag{float:right;font-size:5.6pt;letter-spacing:.08em;text-transform:uppercase;opacity:.7}
.post p{margin:0 0 .32em}
.post p:last-child{margin-bottom:0}
.q{margin:4.5pt 0 0;padding:1pt 0 1pt 6.5pt;border-left:1pt solid {{ ink }};font-size:{{ pt - 0.8 }}pt}
.q .who{font-size:6pt;margin-bottom:2pt}
.end{text-align:center;margin:10pt 0 0;padding-top:7pt;border-top:.55pt solid {{ ink }};break-inside:avoid}
.end .mark{letter-spacing:.5em;font-size:7pt;margin:0 0 4pt}
.end .line{font:italic 400 {{ pt + 1.2 }}pt/1.25 "SG Serif",serif;margin:0 0 4pt}
.end .note{font:400 6.3pt/1.3 "SG Sans",sans-serif;margin:0}
.pad{break-before:page;height:1in}
</style></head><body>
<header class="mast"><span class="t">{{ paper.name }}</span>
  <span class="meta">{{ date_long }}{% if weather.ok and weather.hi is defined %}<br>{{ weather.label }} · High {{ weather.hi }}° · Low {{ weather.lo }}°{% endif %}</span></header>
<div class="stream">
{% for sec in sections %}
<h2 class="sec-head">{{ sec.title }}</h2>
{% for p in sec["items"] %}
<article class="post">
  <p class="who"><b>{{ p.author }}</b> @{{ p.handle }}{% if p.date_short %} · {{ p.date_short }}{% endif %}<span class="tag">{{ sec.title }}</span></p>
  {% for para in p.text | paras %}<p>{% for line in para %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
  {% endfor %}
  {% if p.quoted %}<div class="q"><p class="who"><b>{{ p.quoted.author }}</b> @{{ p.quoted.handle }}</p>
    {% for para in p.quoted.text | paras %}<p>{% for line in para %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
    {% endfor %}</div>{% endif %}
</article>
{% endfor %}
{% endfor %}
<footer class="end"><p class="mark">· · ·</p><p class="line">{{ paper.web.end_line }}</p>
  <p class="note">{{ paper.web.source_note }}{% if coverage %} {{ coverage }}{% endif %}</p></footer>
</div>
{% if pad %}<div class="pad"></div>{% endif %}
</body></html>
