{#- Field Notes PDFs. mode=print: letter, two flowing columns, no boxed cards, white/black ink.
    mode=digital: phone-sized one-column pages (about 410pt wide) on warm paper, large type. Thin rules + typography instead of frames. Name from paper.name. -#}
<!doctype html><html lang="en"><head><meta charset="utf-8">
<title>{{ paper.name }} · {{ date_long }}{{ ' (print)' if mode == 'print' else '' }}</title>
<style>
@font-face{font-family:"SG Serif";src:url({{ static }}/fonts/SourceSerifPro-Regular.ttf);font-weight:400}
@font-face{font-family:"SG Serif";src:url({{ static }}/fonts/SourceSerifPro-It.ttf);font-weight:400;font-style:italic}
@font-face{font-family:"SG Serif";src:url({{ static }}/fonts/SourceSerifPro-Semibold.ttf);font-weight:600}
@font-face{font-family:"SG Sans";src:url({{ static }}/fonts/LibreFranklin.ttf);font-weight:100 900}
{% set ink = '#000' if mode == 'print' else '#1c1914' %}
{% set bg = '#fff' if mode == 'print' else '#f4ecdc' %}
{% set rule = 'rgba(0,0,0,.2)' if mode == 'print' else 'rgba(28,25,20,.2)' %}
{% if mode == 'digital' %}
/* Phone-sized, one-column pages for reading on a phone (PDF attachment). */
@page{size:410pt 740pt;margin:32pt 26pt 40pt;background:{{ bg }};
  @bottom-center{content:"{{ paper.name }} · " counter(page);font:400 9pt "SG Sans",sans-serif;color:{{ ink }}}}
*{box-sizing:border-box}
html{-webkit-print-color-adjust:exact;print-color-adjust:exact}
body{margin:0;color:{{ ink }};background:{{ bg }};font:400 16pt/1.5 "SG Serif",Georgia,serif;orphans:2;widows:2}
.mast{display:block;margin:0 0 16pt;padding-bottom:10pt;border-bottom:1pt solid {{ ink }}}
.mast .t{display:block;font:600 22pt/1.15 "SG Serif",serif;letter-spacing:-.01em;margin:0 0 6pt}
.mast .meta{display:block;font:400 10pt/1.4 "SG Sans",sans-serif;text-align:left}
.stream{column-count:1}
.sec-head{font:600 18pt/1.2 "SG Serif",serif;letter-spacing:-.003em;
  margin:20pt 0 8pt;padding-bottom:5pt;border-bottom:.8pt solid {{ ink }};break-after:avoid}
.passage .verse{font:italic 400 17pt/1.5 "SG Serif",serif;margin:0 0 8pt}
.sec-head:first-child{margin-top:0}
.post{padding:0 0 14pt;margin:0 0 14pt;border-bottom:.4pt solid {{ rule }};break-inside:avoid}
.who{font:400 10pt/1.35 "SG Sans",sans-serif;margin:0 0 6pt;letter-spacing:.01em;break-after:avoid}
.who b{font-weight:600}
.who .tag{display:none}
.post p{margin:0 0 .55em}
.post p:last-child{margin-bottom:0}
.post img{max-width:100%;height:auto;max-height:220pt;display:block;margin:8pt 0}
.q{margin:8pt 0 0;padding:2pt 0 2pt 10pt;border-left:1.5pt solid {{ ink }};font-size:15pt;line-height:1.45}
.q .who{font-size:9pt;margin-bottom:4pt}
.end{text-align:center;margin:18pt 0 0;padding-top:12pt;border-top:.8pt solid {{ ink }};break-inside:avoid}
.end .mark{letter-spacing:.5em;font-size:10pt;margin:0 0 8pt}
.end .joke{margin:0 0 12pt}.end .joke .text{font:italic 400 16pt/1.45 "SG Serif",serif;margin:0 0 6pt}.end .joke .who{font:400 9pt/1.3 "SG Sans",sans-serif;margin:0}
.end .line{font:italic 400 17pt/1.35 "SG Serif",serif;margin:0 0 8pt}
.end .note{font:400 9pt/1.4 "SG Sans",sans-serif;margin:0}
.pad{display:none}
{% else %}
@page{size:Letter;margin:.48in .52in .52in;background:{{ bg }};
  @bottom-center{content:"{{ paper.name }} · " counter(page);font:400 7.5pt "SG Sans",sans-serif;color:{{ ink }}}}
*{box-sizing:border-box}
html{-webkit-print-color-adjust:exact;print-color-adjust:exact}
body{margin:0;color:{{ ink }};background:{{ bg }};font:400 {{ pt }}pt/1.36 "SG Serif",Georgia,serif;orphans:2;widows:2}
.mast{display:flex;justify-content:space-between;align-items:baseline;gap:12pt;margin:0 0 10pt;padding-bottom:5pt;
  border-bottom:.65pt solid {{ ink }}}
.mast .t{font:600 13.5pt/1 "SG Serif",serif;letter-spacing:-.01em}
.mast .meta{font:400 7.4pt/1.25 "SG Sans",sans-serif;text-align:right}
.stream{column-count:2;column-gap:18pt;column-fill:auto;column-rule:.35pt solid {{ rule }}}
.sec-head{font:600 {{ pt + 2.2 }}pt/1.15 "SG Serif",serif;letter-spacing:-.003em;
  margin:11pt 0 5pt;padding-bottom:2.5pt;border-bottom:.5pt solid {{ ink }};break-after:avoid-column}
.passage .verse{font:italic 400 {{ pt + 1.4 }}pt/1.38 "SG Serif",serif;margin:0 0 3pt}
.sec-head:first-child{margin-top:0}
.post{padding:0 0 6.5pt;margin:0 0 6.5pt;border-bottom:.3pt solid {{ rule }}}
.who{font:400 6.6pt/1.2 "SG Sans",sans-serif;margin:0 0 3pt;letter-spacing:.01em;break-after:avoid}
.who b{font-weight:600}
.who .tag{float:right;font-size:5.6pt;letter-spacing:.08em;text-transform:uppercase;opacity:.7}
.post p{margin:0 0 .32em}
.post p:last-child{margin-bottom:0}
.q{margin:4.5pt 0 0;padding:1pt 0 1pt 6.5pt;border-left:1pt solid {{ ink }};font-size:{{ pt - 0.8 }}pt}
.q .who{font-size:6pt;margin-bottom:2pt}
.end{text-align:center;margin:10pt 0 0;padding-top:7pt;border-top:.55pt solid {{ ink }};break-inside:avoid}
.end .mark{letter-spacing:.5em;font-size:7pt;margin:0 0 4pt}
.end .joke{margin:0 0 8pt}.end .joke .text{font:italic 400 {{ pt + 0.8 }}pt/1.35 "SG Serif",serif;margin:0 0 3pt}.end .joke .who{font:400 6.5pt/1.25 "SG Sans",sans-serif;margin:0}
.end .line{font:italic 400 {{ pt + 1.2 }}pt/1.25 "SG Serif",serif;margin:0 0 4pt}
.end .note{font:400 6.3pt/1.3 "SG Sans",sans-serif;margin:0}
.pad{break-before:page;height:1in}
{% endif %}
</style></head><body>
<header class="mast"><span class="t">{{ paper.name }}</span>
  <span class="meta">{{ date_long }}{% if paper.web.read_time %} · {{ read_min }} min read{% endif %}{% if weather.ok and weather.hi is defined %}<br>{{ weather.label }} · High {{ weather.hi }}° · Low {{ weather.lo }}°{% endif %}</span></header>
<div class="stream">
{% for sec in sections %}
<h2 class="sec-head">{{ sec.title }}</h2>
{% for p in sec["items"] %}
{% if p.type == "passage" %}
<article class="post passage">
  <p class="verse">{{ p.text }}</p>
  <p class="who"><b>{{ p.work }}</b> · {{ p.translation or "King James Version" }}</p>
</article>
{% else %}
<article class="post">
  <p class="who"><b>{{ p.author }}</b> @{{ p.handle }}{% if p.date_short %} · {{ p.date_short }}{% endif %}</p>
  {% for para in p.text | paras %}<p>{% for line in para %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
  {% endfor %}
  {% if p.quoted %}<div class="q"><p class="who"><b>{{ p.quoted.author }}</b> @{{ p.quoted.handle }}</p>
    {% for para in p.quoted.text | paras %}<p>{% for line in para %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
    {% endfor %}</div>{% endif %}
</article>
{% endif %}
{% endfor %}
{% endfor %}
<footer class="end"><p class="mark">· · ·</p>
  {% if joke %}<div class="joke"><p class="text">{{ joke.text }}</p>
    <p class="who">— {{ joke.author }}{% if joke.where %} · {{ joke.where }}{% endif %}</p></div>{% endif %}
  <p class="line">{{ paper.web.end_line }}</p>
  <p class="note">{{ paper.web.source_note }}{% if coverage %} {{ coverage }}{% endif %}</p></footer>
</div>
{% if pad %}<div class="pad"></div>{% endif %}
</body></html>
