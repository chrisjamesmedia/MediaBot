{% extends "_base.html.j2" %}
{% set title = paper.name ~ ": editions" %}
{% set description = paper.description | trim %}
{% set noindex = not paper.public %}
{% set body_class = "paperpage" %}
{% block body %}
<main class="wrap narrow">
  <a class="kicker" href="../">← Papers</a>
  <h1 class="pagehead">Editions</h1>
  <ol class="editions">
    {% for e in editions %}
    <li>
      <a class="ed-d" href="{{ e.date }}/"><time datetime="{{ e.date }}">{{ e.date_long }}</time>{% if 'Funnies' in e.sections %}<span class="tag">with Funnies</span>{% endif %}</a>
      <span class="pdfs"><a href="{{ e.date }}/{{ e.pdfs.print }}" target="_blank" rel="noopener">Print</a><span class="dot"> · </span><a href="{{ e.date }}/{{ e.pdfs.digital }}" target="_blank" rel="noopener">Digital</a></span>
    </li>
    {% endfor %}
  </ol>
  <p class="about mute">{{ paper.name }}: {{ paper.description | trim }}</p>
</main>
{% endblock %}
