{#- Field Notes web edition: open editorial newsletter, warm paper, no live X links, a clear end.
    Built by build.py when paper.yaml has `layout: slow`. Name comes from paper.name (one-line rename).
    Phone-first: one calm column at every width. The design is static/magazine.css (shared with Signal Seeker's web edition). -#}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ paper.name }} · {{ date_long }}</title>
<meta name="description" content="{{ description }}">
{% if noindex or private_copy or not paper.public %}<meta name="robots" content="noindex">
{% endif %}
{% if base %}<link rel="canonical" href="{{ base }}{{ url_path }}">
<meta property="og:url" content="{{ base }}{{ url_path }}">
{% endif %}
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ paper.name }} · {{ date_long }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:type" content="article">
<meta name="twitter:card" content="summary">
<meta name="color-scheme" content="light dark">
{% if pdf_mode %}{% include "_pdfmode.html.j2" %}{% else %}{% include "_appmeta.html.j2" %}{% endif %}
<link rel="stylesheet" href="{{ root }}assets/magazine.css">
</head>
<body class="mag fn{{ ' pdfmode' if pdf_mode }}" style="--day:{{ day_accent }};--day-dk:{{ day_accent_dk }}">
{#- Field Notes web edition (layout: slow): the MediaBot magazine design, phone-first and one calm column.
    Numbered dividers, a section's own photo as a full-bleed opener, big serif pull quotes, a paper band for Scripture, a joke card,
    an end card. No live links to x.com anywhere: handle and date are plain text. Styles: static/magazine.css; fades: static/magazine.js. -#}
{% macro text_of(t) -%}{% for para in t | paras %}<p>{% for line in para %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>{% endfor %}{%- endmacro %}
{% set has_contents = sections | length > 1 %}
{% if not pdf_mode %}{% include "_appbar.html.j2" %}{% endif %}
<main class="wrap">
  <header class="mast">
    <div class="topline">
      <time datetime="{{ date }}">{{ date_long }}</time>
    </div>
    <h1><a href="{{ home or '../' }}" title="All editions">{{ paper.name }}</a></h1>
    <div class="under"><div class="meta">
      {% if paper.web.read_time %}<span title="{{ words }} words">{{ read_min }} min read</span>{% endif %}
      {% if weather.ok and weather.hi is defined %}<span title="Open-Meteo, as of {{ weather.asof_full }}">{{ weather.label }} {{ weather.hi }}° / {{ weather.lo }}°</span>{% endif %}
    </div></div>
  </header>
  {% if sections | length > 1 %}<nav class="toc" id="contents" aria-labelledby="toc-h"><h2 id="toc-h">In this edition</h2><ol>{% for sec in sections %}<li><a href="#{{ sec.id }}">{{ sec.title }}</a></li>{% endfor %}</ol></nav>{% endif %}
{% for sec in sections %}
{% set first = sec["items"][0] %}
{% set open_img = first.image if (first.type == "post" and first.image) else None %}
  <section class="sec" id="{{ sec.id }}" aria-labelledby="{{ sec.id }}-h">
{% if open_img %}
    <figure class="hero{{ ' wide' if open_img.w and open_img.h and (open_img.w / open_img.h) > 2.4 }}"><div class="frame"><img src="{{ open_img.web }}" alt="{{ open_img.alt or '' }}" loading="lazy"{% if open_img.w and open_img.h %} width="{{ open_img.w }}" height="{{ open_img.h }}"{% endif %}><span class="shade"></span><div class="over"><span class="kick num" aria-hidden="true"></span><h2 class="sec-head" id="{{ sec.id }}-h">{{ sec.title }}</h2></div></div>{% if open_img.credit %}<figcaption>{{ open_img.credit }}</figcaption>{% endif %}</figure>
{% else %}
    <h2 class="sec-head" id="{{ sec.id }}-h">{{ sec.title }}</h2>
{% endif %}
{% for p in sec["items"] %}
{% if p.type == "passage" %}
    <figure class="passage" id="{{ p.id }}">
      <p class="pk">{{ p.label or "Scripture" }}</p>
      <blockquote class="pt verse">{{ p.text }}</blockquote>
      <figcaption>{{ p.work }} · {{ p.translation or "King James Version" }}</figcaption>
    </figure>
{% else %}
{% set n = p.text | length %}
    <article class="post {{ 'q-l' if n < 140 else ('q-m' if n < 330 else ('q-s' if n < 700 else 'q-s q-r')) }}" id="{{ p.id }}">
      <header><p class="who"><b>{{ p.author }}</b><span class="mute">@{{ p.handle }}{% if p.date_short %} · {{ p.date_short }}{% endif %}</span></p></header>
      <div class="ptext">{{ text_of(p.text) }}</div>
      {% if p.quoted %}<blockquote class="qt">
        <p class="who"><b>{{ p.quoted.author }}</b><span class="mute">@{{ p.quoted.handle }}</span></p>
        {{ text_of(p.quoted.text) }}
      </blockquote>{% endif %}
      {% if p.image and not (loop.first and open_img) %}<figure class="pimg"><img src="{{ p.image.web }}" alt="{{ p.image.alt or '' }}" loading="lazy"{% if p.image.w and p.image.h %} width="{{ p.image.w }}" height="{{ p.image.h }}"{% endif %}>{% if p.image.credit %}<figcaption>{{ p.image.credit }}</figcaption>{% endif %}</figure>{% endif %}
    </article>
{% endif %}
{% endfor %}
    <nav class="sectionnav" aria-label="Section navigation">{% if sections | length > 1 %}<a class="up" href="#contents">↑ Contents</a>{% else %}<span></span>{% endif %}<a class="next" href="#{{ loop.nextitem.id if loop.nextitem else ('joke' if joke else 'end') }}"><span class="nl">Next</span> {{ loop.nextitem.title if loop.nextitem else ('One more thing' if joke else 'The end') }} ↓</a></nav>
  </section>
{% endfor %}
{% if joke %}
  <section class="jokewrap" id="joke" aria-label="One more thing">
    <span class="lbl">One more thing</span>
    <div class="jokecard"><p class="text">{{ joke.text }}</p>
      <p class="who">— {{ joke.author }}{% if joke.where %} · {{ joke.where }}{% endif %}</p></div>
  </section>
{% endif %}
  <footer class="end" id="end" aria-label="End of edition">
    <div class="endcard">
      <span class="check" aria-hidden="true"></span>
      <p class="fin">That’s it for today.</p>
      <p class="finnote">{{ paper.web.end_line }} Nothing else is waiting for you.</p>
      <a class="totop" href="#top">↑ Back to the top</a>
    </div>
    <div class="afterword">
      <p class="note">{{ paper.web.source_note }}{% if coverage %} {{ coverage }}{% endif %}</p>
      <p class="endlinks"><a href="{{ pdfs.digital }}" target="_blank" rel="noopener" download>Download PDF</a><span class="dot"> · </span><a href="{{ pdfs.print }}" target="_blank" rel="noopener">Print version</a><span class="dot"> · </span><a href="{{ home or '../' }}">Past editions</a></p>
    </div>
  </footer>
</main>
{% if not pdf_mode %}<script src="{{ root }}assets/magazine.js"></script>{% endif %}
</body>
</html>
