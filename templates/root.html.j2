{% extends "_base.html.j2" %}
{% set title = site.name %}
{% set description = site.about %}
{% set body_class = "rootpage" %}
{% block body %}
<main class="wrap narrow root">
  <h1 class="pagehead">Papers</h1>
  {% if papers %}<ul class="papers">{% for p in papers %}<li><a href="{{ p.paper.slug }}/">{{ p.paper.name }}</a></li>{% endfor %}</ul>{% endif %}
  <p class="endlinks"><a href="edit/">Make your own edition</a></p>
  <p class="about">{{ site.about }}</p>
</main>
{% endblock %}
